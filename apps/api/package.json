{
  "name": "api",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate",
    "dev": "ts-node --transpile-only src/main.ts",
    "prebuild": "pnpm prisma:generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "pretest": "pnpm prisma:generate",
    "test": "node --import tsx --test 'tests/**/*.test.ts'",
    "pretest:phase2": "pnpm prisma:generate",
    "test:phase2": "node --import tsx --test tests/phase2-critical.test.ts",
    "pretest:e2e": "pnpm prisma:generate",
    "test:e2e": "tsx tests/operational-e2e.e2e.ts",
    "pretest:e2e:rtsp": "pnpm prisma:generate",
    "test:e2e:rtsp": "node --import tsx --test tests/rtsp-pipeline.e2e.ts",
    "pretest:e2e:pg": "pnpm prisma:generate",
    "test:e2e:pg": "node --import tsx --test tests/access-control-postgres.e2e.ts",
    "pretest:e2e:pg-lock": "pnpm prisma:generate",
    "test:e2e:pg-lock": "node --import tsx --test tests/retention-advisory-lock.e2e.ts",
    "prisma": "prisma",
    "import:legacy-camera": "ts-node --transpile-only scripts/import-legacy-camera.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^3.1.2",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.8",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.8",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.8",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.22.0",
    "archiver": "^7.0.1",
    "axios": "^1.18.1",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^4.22.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^8.0.7",
    "onvif": "^0.8.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^7.10.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
