generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CameraStatus {
  UNKNOWN
  ONLINE
  OFFLINE
  ERROR
}

/// Estado COMERCIAL do grupo, para o dono da instalação cortar um cliente final
/// que parou de pagar — o mesmo escalonamento que a Central aplica sobre a
/// instalação inteira, mas um nível abaixo.
///   ACTIVE     acesso normal.
///   RESTRICTED vê o AO VIVO, mas não playback/gravações/exportação.
///   SUSPENDED  não vê nada (o grupo deixa de conceder acesso).
/// O ADMIN da instalação nunca é afetado: ele precisa gerenciar o que bloqueou.
enum GroupAccessStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  VIEWER
}

enum CameraPermissionLevel {
  VIEW
  CONTROL
  RECORD
  ADMIN
}

enum AlarmStatus {
  OPEN
  ACKED
  RESOLVED
}

enum AlarmPriority {
  P1
  P2
  P3
  P4
}

enum AlarmSource {
  STREAM
  HEALTH
  MOTION
  ANALYTICS
  SYSTEM
  MANUAL
}

enum RecordingSource {
  UNKNOWN
  LOCAL
  WORKER
}

model Camera {
  manualRecordingSession ManualRecordingSession?
  id                String  @id @default(uuid())
  /// Identificador operacional curto, único e imutável. O UUID continua sendo
  /// a chave primária interna; este número serve à tela, pesquisa e suporte.
  publicId          Int     @unique @default(autoincrement())
  name              String
  ip                String
  rtspPort          Int     @default(554)
  onvifPort         Int?
  /// Porta HTTP do painel da câmera. Opcional. Serve para os comandos
  /// proprietários (cgi-bin) das marcas que não falam ONVIF direito — sem ela,
  /// o sistema tenta uma lista de portas comuns e às vezes não acerta.
  httpPort          Int?
  username          String
  passwordEncrypted String
  rtspPath          String?
  onvifPath         String?
  onvifProfileToken String?

  // ── CAPACIDADE PTZ (sondada, não adivinhada) ───────────────────────────────
  // Antes disto o front DEDUZIA PTZ de "tem caminho ONVIF configurado"
  // (vmsDataStore), o que marcava toda câmera ONVIF como móvel e enchia a tela
  // de PTZ com câmera fixa. Agora é resultado de sonda real.
  //   null  = ainda não sondada (não é "não tem")
  //   true  = um endpoint aceitou comando PTZ
  //   false = sondada e nenhum endpoint aceitou
  ptzCapable       Boolean?
  // 'auto' = veio da sonda | 'manual' = o operador decidiu. A sonda NUNCA
  // sobrescreve 'manual' — é a saída para equipamento que ela não sabe ler.
  ptzCapableSource String?
  ptzProbedAt      DateTime?

  /// COMO esta câmera participa da detecção de OBJETO (YOLO), que é cara.
  ///   auto (padrão) — roda só se houver LINHA de perímetro desenhada. O
  ///     desenho já é o pedido, e apagá-lo desliga o custo sozinho.
  ///   sempre — roda mesmo sem linha (câmera crítica).
  ///   nunca  — não roda nem com linha (cena movimentada que satura o servidor,
  ///     sem obrigar a apagar a linha que o operador quer manter).
  /// A política da Central é portão acima disto: sem `aiObject` liberado,
  /// nenhuma câmera roda.
  objectMode String @default("auto")

  /// Subconjunto das classes liberadas pela Central que ESTA câmera deve
  /// procurar. Vazio = todas as classes liberadas (retrocompatibilidade).
  aiObjectClasses String[] @default([])

  /// Perfil de confirmação de evento, sem alterar o limiar baixo usado pelo
  /// rastreador: sensitive | balanced | precise.
  aiSensitivity String @default("balanced")

  /// Confiança mínima real, em porcentagem, usada para confirmar o objeto.
  /// Faixa operacional segura: 55–90. Substitui os três rótulos da interface,
  /// mas `aiSensitivity` permanece para compatibilidade com instalações antigas.
  aiConfidence Int @default(70)

  /// CLASSES que iniciam gravação no modo `object` (recordingMode='object').
  ///
  /// Vazio = o conjunto padrão (pessoa + veículos). Existe porque "só grave
  /// quando for gente" e "grave qualquer coisa que se mova ali" são pedidos
  /// diferentes na MESMA instalação: numa portaria de pedestres, carro passando
  /// na rua é ruído; num pátio, é o evento. Sem escolha por câmera, uma das
  /// duas sempre grava errado.
  ///
  /// Vazio (padrão) preserva o comportamento de quem já usava o modo objeto.
  recordingObjectClasses String[] @default([])

  channel                Int          @default(1)
  subtype                Int          @default(0)
  liveChannel            Int?
  liveSubtype            Int?
  recordingChannel       Int?
  recordingSubtype       Int?
  analyticsChannel       Int?
  analyticsSubtype       Int?
  status                 CameraStatus @default(UNKNOWN)
  /// Câmera ativa no sistema. false = desativada: não aparece nas telas ao vivo,
  /// não abre stream (MediaMTX) e não grava — sem apagar o cadastro/histórico.
  enabled                Boolean      @default(true)
  lastSeenAt             DateTime?
  siteId                 String?
  areaId                 String?
  /// Endereço físico informado pelo operador. Não é deduzido do IP da câmera:
  /// IP privado/CGNAT identifica a rede, não o ponto onde o equipamento está.
  locationAddress        String?
  latitude               Float?
  longitude              Float?
  groupId                String?
  recordingEnabled       Boolean      @default(true)
  recordingMode          String       @default("continuous")
  /// Dias que ESTA câmera guarda, quando NÃO segue o grupo.
  retentionDays          Int          @default(3)
  /// Segue a retenção do grupo? Nasce ligado: câmera nova herda a política do
  /// grupo em vez de carregar um número próprio que ninguém revisita.
  retentionFollowsGroup  Boolean      @default(true)
  preferredRtspTransport String       @default("tcp")
  preferredLiveProtocol  String       @default("webrtc")
  /// COMO O VÍDEO CHEGA ATÉ NÓS.
  /// - "rtsp_pull" (padrão): nós discamos para a câmera. Exige que ela seja
  ///   alcançável — IP público, redirecionamento de porta ou VPN.
  /// - "rtmp_push": a CÂMERA disca para nós e publica. Funciona atrás de CGNAT,
  ///   4G e qualquer rede sem porta aberta, porque a conexão nasce de dentro.
  /// O padrão mantém byte a byte o comportamento de toda instalação existente.
  sourceMode             String       @default("rtsp_pull")
  /// SHA-256 da chave de ingestão, para autenticar a publicação em tempo O(1)
  /// sem guardar o segredo em claro. Único: duas câmeras nunca compartilham chave.
  rtmpIngestKeyHash      String?      @unique
  /// A mesma chave cifrada (AES-256-GCM), porque o administrador precisa relê-la
  /// para configurar a câmera. Só o hash autentica; este campo é conveniência.
  rtmpIngestKeyEncrypted String?
  /// CAMINHO PRÓPRIO DO EQUIPAMENTO.
  ///
  /// Muita câmera não deixa escolher para onde publicar: ela monta o caminho
  /// sozinha a partir do número de série (medido: `live/liveStream_H3ZL...`) e
  /// ignora o que se digita depois do endereço. Exigir o NOSSO formato deixaria
  /// esse equipamento de fora para sempre.
  ///
  /// Então o sistema aprende: registra a tentativa, o administrador confirma de
  /// qual câmera é, e o caminho fica vinculado. Publicar em caminho NÃO
  /// registrado continua negado — a confirmação é o que separa a câmera do
  /// cliente de qualquer um na internet.
  rtmpIngestPath         String?      @unique
  streamVideoCodec       String?
  streamWidth            Int?
  streamHeight           Int?
  streamFps              Int?
  streamBitrateKbps      Int?
  recordingVideoCodec    String?
  recordingWidth         Int?
  recordingHeight        Int?
  recordingFps           Int?
  recordingBitrateKbps   Int?
  audioEnabled           Boolean      @default(true)
  aiEnabled              Boolean      @default(true)
  alarmsEnabled          Boolean      @default(true)
  hasEdgeAi              Boolean      @default(false)
  motionTrigger          String       @default("SYSTEM")
  /// Zonas de detecção por câmera (polígonos em coordenadas NORMALIZADAS 0..1,
  /// independentes da resolução de análise). Formato:
  /// [{ id, name, kind: 'include'|'exclude', points: [[x,y], ...] }]
  /// - 'exclude': movimento dentro do polígono é IGNORADO (árvore, rua, céu).
  /// - 'include': se houver ao menos uma, só conta movimento DENTRO delas.
  /// Vazio/null = câmera inteira monitorada (comportamento atual preservado).
  detectionZones         Json?
  /// PRIVACIDADE (LGPD) — câmera dentro da residência do cliente. Quando true, o
  /// CONTEÚDO (ao vivo, gravação, áudio, snapshot, miniatura, clipe) é acessível
  /// SOMENTE ao dono (`ownerUserId`) e a quem ele autorizar. Provedor/dono do
  /// sistema/operadores/admins NÃO veem o conteúdo — nem por privilégio de admin.
  /// O GERENCIAMENTO (retenção, status, grupo, config técnica) permanece com o
  /// admin, mas nenhuma dessas funções renderiza a imagem.
  isPrivate              Boolean      @default(false)
  /// Usuário responsável pela câmera privada (único com acesso ao conteúdo, além
  /// dos que ele autorizar). Null em câmeras normais (gerenciadas pelo provedor).
  ownerUserId            String?
  detectedVideoCodec     String?

  /// MEMÓRIA DO MOSAICO: o que já descobrimos sobre a fonte leve desta câmera.
  /// Antes isso vivia só na memória do processo e sumia a cada reinício, então
  /// câmera SEM stream secundário era sondada para sempre. Ver
  /// helpers/memoria-do-mosaico.helper.ts.
  ///
  /// `gridHasSubStream` nulo = nunca verificado; `false` = verificado e a câmera
  /// não tem — é resposta, não ausência de resposta.
  gridHasSubStream         Boolean?
  /// URL do sub SEM usuário e senha. A credencial mora no cadastro e é
  /// recolocada na hora de usar: um segredo tem um lugar só.
  gridSourceUrl            String?
  gridSourceCodec          String?
  gridSourceWidth          Int?
  gridSourceHeight         Int?
  gridRequiresSanitization Boolean?
  /// Impressão do cadastro quando descobrimos. Mudou o IP/porta/caminho, a
  /// anotação se invalida sozinha.
  gridProbeKey             String?
  gridProbedAt             DateTime?
  detectedWidth            Int?
  detectedHeight           Int?
  detectedFps              Int?
  detectedBitrateKbps      Int?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  site          Site?              @relation(fields: [siteId], references: [id], onDelete: SetNull)
  area          Area?              @relation(fields: [areaId], references: [id], onDelete: SetNull)
  group         CameraGroup?       @relation("PrimaryCameraGroup", fields: [groupId], references: [id], onDelete: SetNull)
  groups        CameraGroup[]      @relation("CameraMemberships")
  owner         User?              @relation("CameraOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  recordings    Recording[]
  exportedClips ExportedClip[]
  events        CameraEvent[]
  alarms        AlarmInstance[]
  permissions   CameraPermission[]
  groupMessages GroupMessage[]

  @@index([siteId])
  @@index([areaId])
  @@index([groupId])
  @@index([status])
}

/// Um destino de armazenamento em nuvem da instalação.
///
/// Uma instalação pode ter VÁRIOS: o cliente troca de fornecedor, ou cresce e
/// contrata um bucket maior. O acervo antigo continua legível no storage de
/// origem enquanto a retenção o esvazia naturalmente, e tudo que é novo já
/// nasce no ativo — sem copiar terabytes entre provedores nem janela de
/// indisponibilidade.
model CloudStorage {
  id                       String   @id @default(uuid())
  /// Nome para o operador reconhecer ("Eveo 1T", "Contabo 10T").
  name                     String
  provider                 String   @default("s3")
  endpoint                 String
  region                   String   @default("us-east-1")
  bucket                   String
  prefix                   String   @default("")
  accessKeyId              String
  /// Cifrada com a mesma chave mestra das senhas de câmera (AES-256-GCM).
  secretAccessKeyEncrypted String
  forcePathStyle           Boolean  @default(true)
  /// SOMENTE UM ativo por instalação: é nele que toda gravação nova é escrita.
  /// Os demais ficam somente-leitura, servindo o acervo que já está neles.
  isActive                 Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  recordings Recording[]

  @@index([isActive])
}

model Recording {
  id                String          @id @default(uuid())
  cameraId          String
  camera            Camera          @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  source            RecordingSource @default(UNKNOWN)
  triggerMode       String          @default("unknown")
  exportedClips     ExportedClip[]
  startedAt         DateTime
  endedAt           DateTime?
  filePath          String
  durationSeconds   Int?
  sizeBytes         BigInt?
  // Retenção em dois níveis. Quantidade de eventos de movimento cobertos pelo
  // segmento: -1 = DESCONHECIDO (backfill, IA desligada, erro ao contar),
  // 0 = sem movimento, > 0 = quantidade de eventos. O DESCONHECIDO fica em
  // QUARENTENA: nunca expira no corte curto (ver retention.service.ts).
  motionScore       Int             @default(-1)
  // Camada de armazenamento. NULL em tudo = só local (estado de todo o acervo
  // anterior ao offload). `cloudUploadedAt` marca o upload CONFIRMADO, e só
  // depois dele o arquivo local pode ser removido — apagar antes perderia a
  // prova para sempre.
  cloudKey          String?
  cloudUploadedAt   DateTime?
  /// EM QUAL storage este objeto está.
  ///
  /// Existe porque uma instalação pode trocar de fornecedor de S3 sem perder o
  /// acervo. Sem esta coluna, o playback montava o cliente a partir da config
  /// ATUAL e procurava a chave antiga no bucket novo — o histórico inteiro
  /// sumia da tela (os dados continuavam lá, inacessíveis, e a retenção também
  /// não os alcançava mais).
  ///
  /// NULL = storage legado (a configuração única `cloud.storage`), para que
  /// instalações anteriores à migração continuem funcionando sem backfill.
  cloudStorageId    String?
  cloudStorage      CloudStorage?   @relation(fields: [cloudStorageId], references: [id], onDelete: SetNull)
  localDeletedAt    DateTime?
  // Vigilância do acervo REMOTO. `cloudVerifiedAt` = última vez que o objeto
  // foi conferido no bucket (HEAD). `cloudMissingSince` = o bucket respondeu
  // SAUDÁVEL e o objeto NÃO estava lá — apagado por fora do sistema. A linha
  // NÃO é removida: ela é o registro de que a gravação existiu e foi destruída
  // externamente, e o mapa (cloudKey) para reencontrá-la se o objeto voltar.
  // Bucket inteiro fora do ar NUNCA marca isto — indisponível não é apagado.
  cloudVerifiedAt   DateTime?
  cloudMissingSince DateTime?
  createdAt         DateTime        @default(now())

  @@unique([filePath])
  @@index([cameraId, startedAt])
  @@index([triggerMode, startedAt])
  @@index([startedAt])
}

model ExportedClip {
  id                String    @id @default(uuid())
  cameraId          String
  camera            Camera    @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  sourceRecordingId String
  sourceRecording   Recording @relation(fields: [sourceRecordingId], references: [id], onDelete: Cascade)
  filePath          String    @unique
  startedAt         DateTime
  endedAt           DateTime
  durationSeconds   Int
  sizeBytes         BigInt?
  fileSha256        String?
  createdByUserId   String?
  createdByUserName String?
  createdAt         DateTime  @default(now())

  @@index([cameraId, startedAt])
  @@index([sourceRecordingId])
  @@index([createdAt])
}

model ManualRecordingSession {
  cameraId       String   @id
  camera         Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  expiresAt      DateTime @db.Timestamptz(6)
  segmentSeconds Int
  owner          String?
  leaseUntil     DateTime? @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @db.Timestamptz(6)
  @@index([expiresAt])
}

model CameraEvent {
  id         String    @id @default(uuid())
  cameraId   String
  camera     Camera    @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  type       String
  severity   String
  message    String
  metadata   Json?
  occurredAt DateTime
  createdAt  DateTime  @default(now())
  /// Fila de REVISÃO: marcado quando um operador revê o evento. Null = não visto.
  reviewedAt DateTime?

  alarms      AlarmInstance[]
  userReviews UserEventReview[]

  @@index([cameraId, type, occurredAt])
  @@index([occurredAt])
  @@index([reviewedAt])
}

/// Revisão POR USUÁRIO: cada operador tem o seu próprio "visto". Substitui o
/// reviewedAt global do CameraEvent (que marcava como visto para TODOS de uma vez).
model UserEventReview {
  userId     String
  eventId    String
  reviewedAt DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      CameraEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId])
}

model AlarmRule {
  id                    String        @id @default(uuid())
  name                  String
  source                AlarmSource
  eventType             String
  priority              AlarmPriority @default(P3)
  isEnabled             Boolean       @default(true)
  dedupWindowSeconds    Int           @default(60)
  autoResolveOnRecovery Boolean       @default(false)
  notifyOnOpen          Boolean       @default(true)
  webhookUrl            String?
  emailTo               String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([source, eventType])
  @@index([isEnabled])
  @@index([source, eventType])
}

model AlarmInstance {
  id                     String        @id @default(uuid())
  cameraId               String?
  camera                 Camera?       @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  eventId                String?
  event                  CameraEvent?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  source                 AlarmSource
  type                   String
  title                  String
  message                String
  severity               String
  priority               AlarmPriority
  status                 AlarmStatus   @default(OPEN)
  metadata               Json?
  note                   String?
  occurrenceCount        Int           @default(1)
  firstOccurredAt        DateTime
  lastOccurredAt         DateTime
  acknowledgedAt         DateTime?
  acknowledgedByUserId   String?
  acknowledgedByUserName String?
  resolvedAt             DateTime?
  resolvedByUserId       String?
  resolvedByUserName     String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([cameraId, status])
  @@index([status, priority, lastOccurredAt])
  @@index([source, type])
  @@index([eventId])
}

model User {
  id           String   @id @default(uuid())
  name         String
  /// Identificador usado no login. Aceita e-mail, mas não DEPENDE dele:
  /// `beira_mar`, por exemplo, é uma conta válida.
  username     String   @unique
  /// Canal opcional de recuperação de senha. Não é mais a identidade da conta.
  email        String?  @unique
  passwordHash String
  authVersion  Int      @default(0)
  role         UserRole @default(VIEWER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  auditLogs         AuditLog[]
  cameraPermissions CameraPermission[]
  investigations    Investigation[]
  pushDevices       PushDevice[]
  liveLayouts       LiveLayout[]
  mosaicosRecebidos LiveLayoutShare[]
  authSessions      AuthSession[]
  eventReviews      UserEventReview[]
  ownedCameras      Camera[]           @relation("CameraOwner")
  groupMessages     GroupMessage[]
  rondas            Ronda[]
  rondasRecebidas   RondaShare[]
}

model AuthSession {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  authVersion Int
  expiresAt   DateTime
  lastUsedAt  DateTime  @default(now())
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model LiveLayout {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  gridSize     String
  cameraIds    Json
  /// Desligar sem apagar: o mosaico do evento de fim de ano não precisa sumir
  /// em janeiro, precisa parar de aparecer.
  active       Boolean           @default(true)
  /// Um mosaico 4x4 é ilegível no celular. Quem monta decide se ele desce
  /// para o aplicativo.
  showOnMobile Boolean           @default(true)
  shares       LiveLayoutShare[]
  lastUsedAt   DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId, updatedAt])
}

/// Dispositivo móvel registrado para receber push de alarmes. Tokens novos
/// Android usam o prefixo `fcm:`; tokens Expo legados são mantidos durante a
/// migração para não interromper alertas de aplicativos já instalados.
model PushDevice {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String? // ios | android
  deviceName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

/// Silenciamento de notificações push POR USUÁRIO e POR CÂMERA. Se existe uma
/// linha (userId, cameraId), aquele usuário NÃO recebe push daquela câmera —
/// os outros usuários seguem recebendo normalmente. As FKs são criadas na
/// migração (sem relação Prisma p/ não exigir campos reversos em User/Camera).
model NotificationMute {
  id        String   @id @default(uuid())
  userId    String
  cameraId  String
  createdAt DateTime @default(now())

  @@unique([userId, cameraId])
  @@index([cameraId])
}

model AiSettings {
  id      String  @id @default("global")
  enabled Boolean @default(true)
  mode    String  @default("motion")

  /// Desenhar a caixa do objeto sobre o vídeo ao vivo.
  ///
  /// É preferência OPERACIONAL, não de escopo — por isso mora aqui e não na
  /// Central: quem opera decide se quer ver a marcação na tela. Antes disto só
  /// existia a variável de ambiente GENERAL_OVERLAY_MODE, igual para toda a
  /// frota e só alterável recriando container.
  showObjectBox Boolean @default(true)

  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Investigation {
  id                String   @id @default(uuid())
  title             String
  status            String   @default("OPEN")
  summary           String?
  selectedCameraIds Json
  timeStart         DateTime
  timeEnd           DateTime
  playbackSpeed     String   @default("1x")
  activeTrackTime   Int      @default(0)
  createdByUserId   String?
  createdByUserName String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdBy User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  items     InvestigationItem[]

  @@index([createdAt])
  @@index([updatedAt])
  @@index([status])
}

model InvestigationItem {
  id              String        @id @default(uuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  type            String
  label           String
  cameraId        String?
  cameraName      String?
  eventId         String?
  recordingId     String?
  timestamp       DateTime
  notes           String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([investigationId, timestamp])
  @@index([cameraId])
  @@index([eventId])
  @@index([recordingId])
}

model Site {
  id          String   @id @default(uuid())
  name        String
  description String?
  location    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  areas      Area[]
  cameras    Camera[]
  mapLayouts SiteMapLayout[]

  @@index([name])
}

model SiteMapLayout {
  id         String   @id @default(uuid())
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  floor      String
  svgDataUrl String?
  markers    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([siteId, floor])
  @@index([siteId])
  @@index([floor])
}

model Area {
  id          String   @id @default(uuid())
  siteId      String?
  site        Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cameras Camera[]

  @@index([siteId])
  @@index([name])
}

model CameraGroup {
  id                String            @id @default(uuid())
  name              String
  description       String?
  isActive          Boolean           @default(true)
  /// Bloqueio comercial do grupo (ver GroupAccessStatus). Default ACTIVE: todo
  /// grupo existente continua exatamente como está após a migração.
  accessStatus      GroupAccessStatus @default(ACTIVE)
  /// Motivo mostrado ao cliente final quando o grupo está restrito/suspenso.
  accessMessage     String?
  /// Cota de câmeras PRIVADAS que os usuários deste grupo podem cadastrar pelo
  /// app ("+ Adicionar câmera"). É o "acordado" com o cliente. 0 = não pode
  /// cadastrar câmera privada (padrão seguro: liberado só quando o admin define).
  maxPrivateCameras Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  /// Retenção do GRUPO. Todo grupo nasce com um número — grupo sem valor
  /// deixaria o toggle "seguir o grupo" apontando para o nada.
  retentionDays     Int                @default(3)
  cameras           Camera[]         @relation("CameraMemberships")
  primaryCameras    Camera[]         @relation("PrimaryCameraGroup")
  permissions       CameraPermission[]
  messages          GroupMessage[]
  mosaicosRecebidos LiveLayoutShare[]
  rondasRecebidas   RondaShare[]

  @@index([name])
}

model CameraPermission {
  id        String                @id @default(uuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cameraId  String?
  camera    Camera?               @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  groupId   String?
  group     CameraGroup?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  level     CameraPermissionLevel
  createdAt DateTime              @default(now())

  @@index([userId])
  @@index([cameraId])
  @@index([groupId])
}

model SystemSetting {
  key             String   @id
  value           String
  updatedAt       DateTime @default(now()) @updatedAt
  updatedByUserId String?
}

model RolePermission {
  role        UserRole @id
  permissions Json
  updatedAt   DateTime @default(now()) @updatedAt
}

/// Conversa do grupo — e o botão de pânico.
///
/// Pedido em 25/08/2026: num condomínio com dez moradores, quem vê algo estranho
/// clica em ALERTA e todos recebem push com vibração. O alerta É uma mensagem
/// marcada, na mesma conversa, de propósito: alerta sem conversa é beco sem
/// saída — dez pessoas recebem "atenção na câmera 3" e ninguém consegue dizer
/// "já vi, é o entregador".
model GroupMessage {
  id        String           @id @default(uuid())
  groupId   String
  group     CameraGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      GroupMessageKind @default(TEXT)
  body      String
  /// Câmera que motivou o alerta, quando houver. Apagar a câmera não apaga o
  /// histórico do incidente — por isso SetNull e não Cascade.
  cameraId  String?
  camera    Camera?          @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())
  /// Quando esta mensagem some. Calculado na criação: a política pode mudar
  /// depois, e mensagem já enviada não deve mudar de prazo pelas costas.
  expiresAt DateTime

  @@index([groupId, createdAt])
  @@index([expiresAt])
}

enum GroupMessageKind {
  TEXT
  ALERT
}

/// RONDA: o mural passa de um mosaico para outro, sozinho.
///
/// Pedido em 25/08/2026. O nome é o do ofício — o vigia faz a RONDA, passando de
/// ponto em ponto — e cada parada tem seu tempo, porque o portão merece mais que
/// o corredor.
///
/// As paradas ficam em JSON (`[{ layoutId, segundos }]`) de propósito: é uma
/// lista ORDENADA e curta, sempre lida inteira. Tabela separada custaria uma
/// junção e uma ordem explícita para guardar o que já é um vetor.
model Ronda {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  /// `[{ layoutId: string, segundos: number }]`, na ordem em que aparecem.
  paradas      Json
  active       Boolean      @default(true)
  showOnMobile Boolean      @default(true)
  shares       RondaShare[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId, updatedAt])
}

/// A ENTREGA de um mosaico. Uma linha = "esta pessoa" ou "este grupo" pode USAR
/// o mosaico. Usar, não editar: o dono continua sendo quem o criou.
///
/// Cuidado que não é óbvio: receber o mosaico NÃO dá acesso às câmeras dele. A
/// filtragem por permissão acontece na hora de servir (ver
/// compartilhamento.helper.ts). Esta tabela diz "pode abrir", jamais "pode ver".
model LiveLayoutShare {
  id        String       @id @default(uuid())
  layoutId  String
  layout    LiveLayout   @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String?
  group     CameraGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([layoutId, userId])
  @@unique([layoutId, groupId])
  @@index([userId])
  @@index([groupId])
}

/// A ENTREGA de uma ronda. Mesmas regras da entrega de mosaico.
///
/// Receber a ronda dá direito de USAR os mosaicos que ela contém — senão o
/// operador abriria uma ronda de paradas vazias. Esse direito é derivado na
/// consulta, não copiado para cá: assim, tirar o mosaico da ronda tira o
/// acesso junto, sem linha órfã.
model RondaShare {
  id        String       @id @default(uuid())
  rondaId   String
  ronda     Ronda        @relation(fields: [rondaId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String?
  group     CameraGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([rondaId, userId])
  @@unique([rondaId, groupId])
  @@index([userId])
  @@index([groupId])
}
