{
  "openapi": "3.0.3",
  "info": {
    "title": "S2Cam — Integração SGP",
    "version": "1.3.0",
    "description": "Contrato único para todos os provedores. Envie eventos à instalação com seu token exclusivo gerenciado pela Central. CPF é login e senha inicial; troca obrigatória no primeiro acesso. CNPJ numérico exige cliente.responsavel.cpf. Reenvios preservam senha. Retenção ausente: 3 dias; gravação ausente: manual. Políticas do serviço alteram somente câmeras exclusivas. Compartilhadas preservam suas configurações. Arquivamento preserva dados sujeitos à retenção normal."
  },
  "externalDocs": {
    "description": "Documentação oficial do conector S2Cam",
    "url": "https://s2cam.com.br/developers/sgp"
  },
  "servers": [
    {
      "url": "https://{installationDomain}/api",
      "description": "A instalação recebe os eventos; s2cam.com.br hospeda a documentação.",
      "variables": {
        "installationDomain": {
          "default": "vibe.s2cam.com.br",
          "description": "Hostname da instalação, sem protocolo ou barras. Exemplo: ibtelecom.s2cam.com.br."
        }
      }
    }
  ],
  "security": [
    {
      "SgpKey": []
    }
  ],
  "paths": {
    "/integrations/v1/sgp/webhook": {
      "post": {
        "operationId": "receiveSgpEvent",
        "summary": "Cadastrar ou atualizar cliente e serviço",
        "description": "Envie estado completo em todas as ações. Eventos antigos são ignorados; dados diferentes com data idêntica retornam 409. Preserve corpo, data e Idempotency-Key ao reenviar. Mapeie situações e planos antes da homologação. Cotas de serviços não arquivados são somadas; suas políticas de retenção/gravação precisam ser iguais.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "description": "Recomendado. ID único por evento e integração; conteúdo diferente com mesma chave retorna 409. Sem chave, deduplicação pelo conteúdo normalizado."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Event"
              },
              "example": {
                "acao": "cadastrar",
                "data": "2026-10-15T10:00:00.123456-03:00",
                "cliente": {
                  "id": "123",
                  "cpfcnpj": "52998224725",
                  "nome": "Cliente de exemplo"
                },
                "contrato": {
                  "id": "456"
                },
                "servico": {
                  "id": "789",
                  "status": "ATIVO",
                  "plano": {
                    "id": "10"
                  },
                  "limites": {
                    "cameras_privadas": 2,
                    "retencao_dias": 3
                  },
                  "gravacao": {
                    "modo": "objeto",
                    "classes_objeto": [
                      "person"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Solicitação persistida. Consulte operation_id até COMPLETE ou IGNORED. PENDING aguarda aplicação. COMPLETE confirma configuração aplicada; não garante sinal de uma câmera offline.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos, plano não autorizado ou situação sem mapeamento.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Token inválido, substituído ou integração desativada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Acesso negado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Cliente/operação não encontrado nesta integração.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflito de vínculo, política, data ou identificador de evento.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Corpo da solicitação excede o limite aceito pelo servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "423": {
            "description": "Retenção ou detecção requerida não liberada na licença. Corrija o plano ou a licença antes de reenviar.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Limite de solicitações. Aguarde; respeite Retry-After quando presente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Serviço temporariamente indisponível. Reenvie a mesma solicitação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
