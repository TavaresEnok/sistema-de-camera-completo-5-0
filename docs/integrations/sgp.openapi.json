  "components": {
    "securitySchemes": {
      "SgpKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Central → Clientes e servidores → instalação → Integrações → gerar token SGP. Aguarde aplicação. Envie Authorization: Bearer SUA_CHAVE. Nunca envie o token na URL."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Código estável quando disponível."
          }
        }
      },
      "Event": {
        "type": "object",
        "required": [
          "acao",
          "data",
          "cliente",
          "contrato",
          "servico"
        ],
        "properties": {
          "acao": {
            "type": "string",
            "enum": [
              "cadastrar",
              "atualizar",
              "alterar_plano",
              "alterar_status"
            ]
          },
          "data": {
            "type": "string",
            "maxLength": 50,
            "description": "dd/MM/yyyy HH:mm:ss.ffffff no fuso configurado (padrão UTC−3), ou ISO 8601 com fuso; até 6 casas decimais. Preserve data original nos reenvios. Mais de 5 minutos no futuro é rejeitado."
          },
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "description": "Opcional. Idempotency-Key tem precedência."
          },
          "cliente": {
            "type": "object",
            "required": [
              "id",
              "cpfcnpj",
              "nome"
            ],
            "properties": {
              "id": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "nome": {
                "type": "string",
                "minLength": 1,
                "maxLength": 150
              },
              "cpfcnpj": {
                "type": "string",
                "maxLength": 18,
                "description": "CPF válido ou CNPJ numérico válido, com ou sem pontuação. CNPJ exige responsavel.cpf. Login e senha inicial serão o CPF do responsável."
              },
              "responsavel": {
                "type": "object",
                "required": [
                  "cpf"
                ],
                "properties": {
                  "cpf": {
                    "type": "string",
                    "maxLength": 18,
                    "description": "CPF válido obrigatório para CNPJ. Alteração do responsável exige revisão administrativa do vínculo."
                  }
                }
              }
            }
          },
          "contrato": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  },
                  {
                    "type": "integer"
                  }
                ]
              }
            }
          },
          "servico": {
            "type": "object",
            "required": [
              "id",
              "status",
              "plano"
            ],
            "properties": {
              "id": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "status": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "Situação mapeada no S2Cam; desconhecida retorna 400."
              },
              "plano": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 150
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  }
                }
              },
              "limites": {
                "type": "object",
                "properties": {
                  "cameras_privadas": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000,
                    "default": 0
                  },
                  "retencao_dias": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3650,
                    "default": 3,
                    "description": "Sujeito ao contrato da instalação. Redução pode remover vídeos antigos pela limpeza normal."
                  }
                }
              },
              "gravacao": {
                "type": "object",
                "description": "Ausente: manual. Não altera política das câmeras compartilhadas.",
                "properties": {
                  "modo": {
                    "type": "string",
                    "enum": [
                      "continua",
                      "manual",
                      "movimento",
                      "objeto"
                    ],
                    "default": "manual"
                  },
                  "classes_objeto": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "type": "string",
                      "enum": [
                        "person"
                      ]
                    },
                    "description": "Aceito somente no modo objeto. Ausente nesse modo usa person."
                  }
                }
              }
            }
          }
        }
      },
      "Accepted": {
        "type": "object",
        "required": [
          "operation_id",
          "status",
          "customer_status"
        ],
        "properties": {
          "gateway_id": {
            "type": "string",
            "format": "uuid",
            "description": "ID do vínculo. Presente no webhook."
          },
          "gateway_params_extra": {
            "type": "string",
            "format": "uuid",
            "description": "ID do grupo. Presente no webhook."
          },
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "COMPLETE",
              "IGNORED"
            ]
          },
          "customer_status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED",
              "ARCHIVED"
            ]
          },
          "repeated": {
            "type": "boolean"
          }
        }
      },
      "Operation": {
        "type": "object",
        "required": [
          "operation_id",
          "status",
          "attempts"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "COMPLETE",
              "IGNORED"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "externalCustomerId": {
            "type": "string"
          },
          "groupId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED",
              "ARCHIVED"
            ]
          },
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "revision": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "group": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "maxPrivateCameras": {
                "type": "integer",
                "minimum": 0
              },
              "retentionDays": {
                "type": "integer",
                "nullable": true
              },
              "_count": {
                "type": "object",
                "properties": {
                  "cameras": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "user": {
            "type": "object",
            "properties": {
              "username": {
                "type": "string",
                "description": "CPF sem pontuação. Não retorna senha."
              },
              "mustChangePassword": {
                "type": "boolean"
              }
            }
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "externalServiceId": {
                  "type": "string"
                },
                "externalContractId": {
                  "type": "string"
                },
                "externalPlanId": {
                  "type": "string"
                },
                "privateCameraLimit": {
                  "type": "integer",
                  "minimum": 0
                },
                "retentionDays": {
                  "type": "integer",
                  "minimum": 1
                },
                "recordingMode": {
                  "type": "string",
                  "enum": [
                    "continuous",
                    "manual",
                    "motion",
                    "object"
                  ],
                  "description": "Consulta retorna nomes internos em inglês; envie os nomes portugueses documentados."
                },
                "recordingObjectClasses": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "person"
                    ]
                  }
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "ACTIVE",
                    "SUSPENDED",
                    "ARCHIVED"
                  ]
                },
                "sourceAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "example": "1.3.0"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recording": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "objectRecordingClasses": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "person"
              ]
            }
          },
          "initialPasswordChangeRequired": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "customerDocuments": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "CPF",
                "CNPJ_NUMERIC"
              ]
            }
          },
          "sharedCameraPolicy": {
            "type": "string",
            "enum": [
              "preserve_camera_settings"
            ]
          },
          "tokenManagement": {
            "type": "string",
            "enum": [
              "central_when_managed"
            ]
          }
        }
      }
    }
  }
}
