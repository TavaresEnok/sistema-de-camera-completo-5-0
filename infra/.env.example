POSTGRES_USER=vms
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=vms_db
POSTGRES_BACKUP_RETENTION_DAYS=30
POSTGRES_BACKUP_INTERVAL_SECONDS=604800
POSTGRES_BACKUP_VERIFY_INTERVAL_SECONDS=86400
POSTGRES_BACKUP_VERIFY_INITIAL_DELAY_SECONDS=900
CENTRAL_DATA_DIR=../apps/central/data
CENTRAL_BACKUP_INTERVAL_SECONDS=604800
CENTRAL_BACKUP_RETENTION_DAYS=30
DRAC_CENTRAL_STORE_MODE=dual
DRAC_CENTRAL_ADMIN_EMAIL=admin@drac.local
DRAC_CENTRAL_ADMIN_PASSWORD_HASH=
DRAC_CENTRAL_ADMIN_TOKEN=
DRAC_CENTRAL_ALLOWED_ORIGINS=https://localhost
DRAC_CENTRAL_TRUSTED_PROXIES=172.16.0.0/12
DRAC_CENTRAL_COOKIE_SECURE=true
DRAC_CENTRAL_PUBLIC_URL=https://localhost/central
DRAC_CENTRAL_INSTALLER_COMMIT=
DRAC_CENTRAL_INSTALLER_SHA256=
DRAC_CENTRAL_INSTALLER_URL_TEMPLATE=https://raw.githubusercontent.com/TavaresEnok/sistema-de-camera-completo-5-0/{commit}/scripts/install-drac.sh
DRAC_CENTRAL_REPOSITORY_URL=https://github.com/TavaresEnok/sistema-de-camera-completo-5-0.git
DRAC_CENTRAL_INSTALLER_TOKEN_TTL_SECONDS=900
DRAC_CENTRAL_INSTALLER_TOKEN_MAX_DOWNLOADS=3
APP_BUILDER_AGENT_URL=http://host.docker.internal:8780
APP_BUILDER_AGENT_TOKEN=
APP_BUILDER_AGENT_TIMEOUT_MS=15000
KEYSTORE_BACKUP_DIR=/home/flashnet/keystore-backups
# Perfil opcional: docker compose --profile offsite-backup up -d offsite-backup
OFFSITE_BACKUP_REMOTE=
OFFSITE_BACKUP_INTERVAL_SECONDS=604800
OFFSITE_BACKUP_RETENTION_DAYS=90
OFFSITE_INCLUDE_RECORDINGS=false
RCLONE_CONFIG_PATH=./rclone.conf

# Arquivos finais de reativação (somente no servidor mestre/Central).
# Use segredo exclusivo, diferente de JWT/CAMERA_SECRET_KEY, com 32+ caracteres.
DRAC_CENTRAL_ARCHIVE_KEY=
DRAC_CENTRAL_ARCHIVE_DIR=./data/reactivation-archives
DRAC_CENTRAL_ARCHIVE_RETENTION_MONTHS=24

JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
AUTH_REFRESH_INACTIVITY_DAYS=7
CAMERA_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_STRONG_INTERNAL_TOKEN_MIN_24_CHARS
EVIDENCE_HMAC_SECRET=REPLACE_WITH_STRONG_EVIDENCE_HMAC_SECRET_MIN_32_CHARS
EVIDENCE_HMAC_KEY_ID=local-v1
# Inclua aqui os dominios/IPs reais do frontend em producao.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_APP_URL=http://127.0.0.1:5173
API_PUBLIC_URL=http://127.0.0.1:3000
VITE_API_URL=
COOKIE_SECURE=false
# Quantos proxies CONTROLADOS existem entre o cliente e o Express. Com o nginx do host
# fazendo proxy p/ 127.0.0.1:3000, é 1. Valor MAIOR que a realidade faz o Express confiar
# no X-Forwarded-For enviado pelo CLIENTE → req.ip forjável → bypass do rate limit de
# login e IP falso na auditoria.
TRUST_PROXY_HOPS=1
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_STARTUP_TIMEOUT_MS=10000

# Rotacao de logs dos containers. Evita disco cheio por logs longos.
DOCKER_LOG_MAX_SIZE=50m
DOCKER_LOG_MAX_FILES=5

# ── DRAC Central / conector cloud ──────────────────────────────
# Desligado por padrao. Ative apenas quando esta instalacao local
# deve enviar heartbeat e metricas para o painel central.
CLOUD_CONNECTOR_ENABLED=false
CLOUD_API_URL=http://127.0.0.1:9765
CLOUD_INSTALLATION_ID=
CLOUD_LICENSE_KEY=
CLOUD_CUSTOMER_NAME=
CLOUD_HEARTBEAT_INTERVAL_SECONDS=60
CLOUD_CONNECTOR_TIMEOUT_MS=8000
DRAC_VERSION=local
DRAC_LAUNCH_PROFILE=standard

# Binds usados por infra/docker-compose.prod.yml.
DRAC_API_BIND=127.0.0.1
DRAC_WEB_BIND=127.0.0.1
DRAC_POSTGRES_BIND=127.0.0.1
DRAC_REDIS_BIND=127.0.0.1
DRAC_MEDIAMTX_RTSP_BIND=127.0.0.1
DRAC_MEDIAMTX_HLS_BIND=127.0.0.1
DRAC_MEDIAMTX_WEBRTC_HTTP_BIND=127.0.0.1
DRAC_MEDIAMTX_WEBRTC_UDP_BIND=0.0.0.0
MEDIAMTX_TURN_URL=
MEDIAMTX_TURN_SECRET=

RETENTION_DAYS=7
RECORDING_RETENTION_DAYS=7
RECORDING_AUTO_START_ENABLED=true
RECORDING_AUTO_START_DELAY_MS=10000
RECORDING_DISK_GUARD_ENABLED=true
RECORDING_DISK_GUARD_INTERVAL_MS=30000
RECORDING_DISK_GUARD_MAX_USED_PERCENT=92
MOTION_RECORDING_POST_ROLL_SECONDS=90
MOTION_RECORDING_SEGMENT_SECONDS=120
MOTION_ALARM_QUIET_SECONDS=300
MOTION_EVENT_DEBOUNCE_SECONDS=45
# Protecao MOG2 contra nuvem, luz piscando, farol e exposicao automatica.
# Para rollback integral da etapa nova, use MOTION_ILLUMINATION_COMPENSATION=false.
MOTION_ILLUMINATION_COMPENSATION=true
MOTION_PHOTOMETRIC_SCENE_SUPPRESSION=true
MOTION_ILLUMINATION_MIN_SHIFT=8.0
MOTION_ILLUMINATION_RESIDUAL_THRESHOLD=10.0
MOTION_ILLUMINATION_UNIFORM_RATIO=0.72
MOTION_ILLUMINATION_BLOCK_UNIFORM_RATIO=0.75
MOTION_ILLUMINATION_ALPHA=0.02
MOTION_ILLUMINATION_RECOVERY_ALPHA=0.02
# Codec da gravacao: copy (padrao, arquiva o stream original sem reencode e sem
# custo de CPU) | h265 (transcoda fontes nao-HEVC para H.265, economiza disco) |
# h264 (transcoda fontes nao-H.264 para H.264). Fontes H.265 ja sao copiadas.
FFMPEG_RECORDING_CODEC_MODE=copy
RETENTION_USE_BULLMQ=true

MEDIAMTX_API_BASE_URL=http://mediamtx:9997
MEDIAMTX_API_USER=change_me_mediamtx_user
MEDIAMTX_API_PASS=change_me_mediamtx_pass
MEDIAMTX_AUTH_CALLBACK_TOKEN=change_me_mediamtx_callback_token
MEDIAMTX_PUBLIC_HOST=
# IP público ou hostname curto para câmeras cujo campo RTMP aceita no máximo
# 63 caracteres. A API só o usa se a URL canônica não couber; a chave permanece
# com 128 bits. Deixe vazio se não houver endereço curto publicamente roteável.
MEDIAMTX_RTMP_SHORT_HOST=
MEDIAMTX_PUBLIC_SCHEME=
MEDIAMTX_PUBLIC_WEBRTC_URL=
MEDIAMTX_PUBLIC_HLS_URL=
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
# Dev pode usar "*". Em producao, use a origem HTTPS real do frontend.
MEDIAMTX_HLS_ALLOW_ORIGIN=*
MEDIAMTX_WEBRTC_ALLOW_ORIGIN=*
MEDIAMTX_WEBRTC_ADDITIONAL_HOST=127.0.0.1

# Se o IP público desta máquina mudar, rode scripts/trocar-ip.sh: o host acima
# é o ÚNICO endereço que o navegador recebe para o vídeo ao vivo. O watchdog
# acusa `live:webrtc-host-nao-e-desta-maquina` quando ele não pertence a este
# host. NAT 1:1 legítimo (IP público só no roteador): descomente.
#DRAC_WEBRTC_HOST_NAT=true

# Borda RTMP (quem atende a 1935 pública) — ver infra/docker-compose.yml.
# Padrão: SRS na 1935. Câmeras entrando pelo SRS da Gateway: descomente as duas.
#DRAC_SRS_RTMP_PUBLISH=127.0.0.1:19351
#DRAC_MEDIAMTX_RTMP_PUBLISH=1935
MEDIAMTX_RUN_ON_DEMAND_CLOSE_AFTER=5m
MEDIAMTX_WARM_PATHS_ON_BOOT=true
MEDIAMTX_MAX_CONCURRENT_TRANSCODES=
# Relative resource points: copy/audio=1, small video encode=2, heavy/unknown=4.
# Independent from the process count ceiling; measured load guides tuning.
# Empty: size to available CPU/cgroup quota. New conversions also respect
# 75% host CPU and 10% available memory reserves; existing viewers continue.
# Override only after measuring the complete workload (live + recording + AI).
MEDIAMTX_MAX_TRANSCODE_POINTS=
# Shares only identical physical RTSP URLs/transport; main/sub never substitute.
CAMERA_SHARED_RTSP_ENABLED=true
MEDIAMTX_TRACK_HEALTH_ENABLED=true
ALARM_WEBHOOK_ALLOWED_HOSTS=
ALARM_WEBHOOK_SIGNING_SECRET=
CAMERA_TEST_ALLOW_PUBLIC_IP=false
# Egress de RTSP/ONVIF: use somente as VLANs reais de câmeras. Loopback,
# link-local/metadata e multicast são negados mesmo se incluídos aqui.
CAMERA_ALLOWED_CIDRS=
CAMERA_DENIED_CIDRS=
# Redes CGNAT de câmeras somente quando o provedor entregou rota privada até
# esta instalação. Aceita CIDRs contidos em 100.64.0.0/10, separados por vírgula.
CAMERA_TRUSTED_CGNAT_CIDRS=
# Compatibilidade com instalações que já cadastraram exceções host-a-host.
CAMERA_TRUSTED_CGNAT_IPS=

# ── IA: configuração geral ────────────────────────────────────
# Arma sozinha a análise das câmeras marcadas com IA (só o detector de
# MOVIMENTO; objeto e rosto são outro caminho, com política comercial própria).
#
# Ficou `false` aqui desde 03/06/2026 ("standard launch profile"), enquanto o
# docker-compose assume `true` quando a chave não existe. Como o instalador
# COPIA este arquivo, toda instalação nascia com a sincronização desligada — e
# o efeito só aparecia depois: câmera marcada com IA, nenhum detector armado,
# health-check gritando "detector cego" e a gravação de emergência ligando
# contínuo. Medido na Vibe (18/09/2026): 34 câmeras marcadas, 0 analisadas,
# 241 avisos de cego em 24 h e 698 trechos gravados por socorro numa câmera só.
#
# Agora os dois padrões dizem a mesma coisa. Para uma instalação que realmente
# não deve analisar nada, ponha `false` E desmarque a IA nas câmeras — senão o
# verificador de prontidão acusa a contradição.
AI_AUTO_START_ENABLED=true
AI_ONVIF_MOTION_EVENTS_ENABLED=true
INTELBRAS_GENERIC_MOTION_EVENTS_ENABLED=false
INTELBRAS_GENERIC_MOTION_COOLDOWN_SECONDS=30
# Roteamento geral da IA. O passthrough HEVC validado abaixo ainda usa o
# MediaMTX para compartilhar uma única sessão da câmera, sem transcodificar.
AI_USE_MEDIAMTX=false
AI_RTSP_SUBTYPE=auto
# Somente habilite depois de provar captura HEVC no mesmo build do ai-service.
# O codec permanece HEVC, compartilhado pelo MediaMTX. Se a captura degradar,
# o watchdog volta automaticamente ao H.264 interno.
AI_ANALYTICS_HEVC_FALLBACK=true
AI_ANALYTICS_DIRECT_HEVC_ENABLED=false

# Modo global de IA: motion | face | general
# Alterar via API: PATCH /ai/settings {"mode": "face"}
# (ou defina o default aqui; a tabela AiSettings persiste no banco)

# Imagens analisadas por segundo: movimento normal e simulação de movimento.
MOTION_DETECTION_FPS=7.0
AI_CAPTURE_DECODER_THREADS=1
AI_OPENCV_THREADS=1

# QoS de live (PR4)
AI_CPU_RESERVE_PERCENT=14
# vazio = automático por orçamento:
# ai_budget = floor(cpu_logical * (1 - reserve_percent / 100))
# workers ~ sqrt(ai_budget), threads/worker = floor(ai_budget/workers)
AI_INFERENCE_WORKER_COUNT=
AI_INFERENCE_THREADS_OVERRIDE=
AI_SELECTED_DETECTION_FPS=3.0
AI_SELECTED_ANALYSIS_WIDTH=960
AI_SELECTED_ANALYSIS_HEIGHT=540
AI_SELECTED_IMGSZ=640
AI_GRID_DETECTION_FPS=1.0
AI_GRID_ANALYSIS_WIDTH=640
AI_GRID_ANALYSIS_HEIGHT=360
AI_GRID_IMGSZ=512
AI_QOS_LIVE_ENABLED=true

# Adaptação dinâmica suave (PR5)
AI_ADAPTIVE_MODE=true
AI_READINESS_MAX_FRAME_AGE_SECONDS=20
AI_ADAPTIVE_PILOT_CAMERA_IDS=*
AI_ADAPTIVE_WINDOW_SECONDS=6
AI_ADAPTIVE_DEGRADE_COOLDOWN_SECONDS=8
AI_ADAPTIVE_RECOVER_COOLDOWN_SECONDS=15
AI_ADAPTIVE_DROP_RATIO_HIGH=0.12
AI_ADAPTIVE_DROP_RATIO_LOW=0.03
AI_ADAPTIVE_CPU_HIGH=88
AI_ADAPTIVE_CPU_LOW=68
AI_ADAPTIVE_SELECTED_FPS_FACTORS=1.0,0.85,0.70
AI_ADAPTIVE_GRID_FPS_FACTORS=1.0,0.85
AI_ADAPTIVE_SELECTED_IMGSZ_STEPS=640,512,416
AI_ADAPTIVE_GRID_IMGSZ_STEPS=512,416
AI_ADAPTIVE_SELECTED_RESOLUTION_SCALES=1.0,0.92,0.84,0.76
AI_ADAPTIVE_GRID_RESOLUTION_SCALES=1.0,0.90,0.80

# --- Alertas de infra do watchdog (runtime-watchdog.sh) — opcional ---
# Telegram: crie um bot no @BotFather, mande /start pro bot, pegue o chat_id via getUpdates.
DRAC_INSTANCE_NAME=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Alternativa/adicional: webhook genérico (Discord/Slack/ntfy) recebe JSON {"text": "..."}
ALERT_WEBHOOK_URL=

# Incidente de movimento MUITO longo (galho ao vento) emite um marco a cada N
# segundos, para nao sumir da lista do operador. 0 desliga os marcos.
MOTION_INCIDENT_MARK_SECONDS=600

# De onde a GRADE puxa a imagem das câmeras RTSP:
#   sub    (padrão) sempre o stream 2 — leve, cabe muitas câmeras H.265.
#   camera          segue a "Fonte da imagem" do cadastro (Original = stream 1).
#                   Stream 1 em H.265 custa ~1,2 núcleo por câmera na grade.
# O Instantâneo usa o stream 2 nos dois casos.
#GRID_SOURCE_PROFILE=camera
