# IA com contagem de passagem, por cima da IA em produção na Vibe (c2f1a9b).
#
# A imagem da Vibe é drac-ai-perimeter-base:20261103 + uma camada com os módulos
# nativos da c2f1a9b. Aqui: a mesma base, os módulos da c2f1a9b (contexto
# nomeado `vibeapp`, extraído da imagem em produção) e, por cima, só os quatro
# módulos alterados pela contagem. Nada da Dguardian (ce13ccf) entra.
#
#   docker build --network host -f infra/Dockerfile.ai-passage-count \
#     --build-context vibeapp=<pasta com app/ extraído> \
#     --build-arg RELEASE_REVISION=<commit> -t ajustcam-ai-passage-count:<data> .
FROM drac-ai-perimeter-base:20261103 AS compile
USER root
RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ binutils \
    && pip install --no-cache-dir Cython \
    && rm -r /var/lib/apt/lists/*
COPY services/ai-service-python/stream_processor.py /source/stream_processor.py
COPY services/ai-service-python/main.py /source/main.py
COPY services/ai-service-python/contagem_de_passagem.py /source/contagem_de_passagem.py
COPY services/ai-service-python/detectors/tripwire.py /source/detectors/tripwire.py
COPY services/ai-service-python/tests/test_contagem_de_passagem.py /checks/test_contagem_de_passagem.py
RUN cd /checks && PYTHONPATH=/source python test_contagem_de_passagem.py
COPY scripts/security/compile-ai.py /build/compile-ai.py
RUN cd /build && python compile-ai.py \
    && find /native -type f -name '*.so' -exec strip --strip-unneeded '{}' '+'

FROM drac-ai-perimeter-base:20261103
ARG RELEASE_REVISION
LABEL org.opencontainers.image.revision=$RELEASE_REVISION
COPY --from=vibeapp --chown=1000:1000 app/ /app/
COPY --from=compile --chown=1000:1000 /native /app
