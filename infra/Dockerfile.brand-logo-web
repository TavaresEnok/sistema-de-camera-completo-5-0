FROM drac-private-web-builder:20261008 AS build
COPY apps/web /app/apps/web
COPY apps/api/src /app/apps/api/src
COPY apps/mobile /app/apps/mobile
COPY apps/central/src /app/apps/central/src
COPY apps/central/public /app/apps/central/public
COPY scripts /app/scripts
COPY infra /app/infra
WORKDIR /app
ENV VITE_FRONTEND_BUILD_ID=brand-logo-editor-20261014
RUN pnpm --filter web typecheck && pnpm --filter web test && pnpm --filter web build

FROM nginx:alpine
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
RUN chown -R nginx:nginx /var/cache/nginx /var/run /etc/nginx/conf.d
USER nginx
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
