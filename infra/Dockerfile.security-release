# Central build only. No Git, installer secret, master service, source map or
# application source is copied into final images. Dependencies are reused from
# validated builders; final stages start from clean distribution images so old
# application layers cannot be recovered with `docker save`.
ARG API_BUILDER=drac-camera-groups-api-builder:20261003
ARG AI_DEPENDENCIES=drac-pipeline-ai:20261004-recorded-validation
FROM ${API_BUILDER} AS api-build
COPY apps/api/src /app/apps/api/src
RUN cd /app/apps/api && pnpm exec tsc -p tsconfig.json

FROM node:22-alpine AS api
WORKDIR /app
RUN apk add --no-cache ffmpeg openssl
COPY --from=api-build /app/node_modules /app/node_modules
COPY --from=api-build /app/apps/api/node_modules /app/apps/api/node_modules
COPY --from=api-build /app/apps/api/dist /app/apps/api/dist
COPY apps/api/prisma/schema.prisma /app/apps/api/prisma/schema.prisma
COPY apps/api/prisma/migrations /app/apps/api/prisma/migrations
COPY --chmod=755 apps/api/docker-entrypoint.sh /app/apps/api/docker-entrypoint.sh
USER node
EXPOSE 3000
CMD ["/app/apps/api/docker-entrypoint.sh"]

FROM ${AI_DEPENDENCIES} AS ai-build
USER root
COPY services/ai-service-python/*.py /source/
COPY services/ai-service-python/detectors /source/detectors
COPY services/ai-service-python/trackers /source/trackers
COPY scripts/security/compile-ai.py /build/compile-ai.py
RUN cd /build && python compile-ai.py \
    && find /native -type f -name '*.so' -exec strip --strip-unneeded '{}' '+'

FROM python:3.11.16-slim AS ai
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 wget \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1000 --create-home --shell /usr/sbin/nologin drac
COPY --from=ai-build /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=ai-build --chown=1000:1000 /native /app
USER drac
EXPOSE 8000
CMD ["python", "-c", "import os,main,uvicorn;uvicorn.run(main.app,host='0.0.0.0',port=int(os.environ.get('AI_PORT','8000')))"]
