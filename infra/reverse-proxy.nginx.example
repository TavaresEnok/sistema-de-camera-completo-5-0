# Example reverse proxy for DRAC VMS.
# Replace drac.example.com and certificate paths before using.

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

map $arg_token $media_query_authorization {
  ""      "";
  default "Bearer $arg_token";
}
map $http_authorization $media_header_or_query {
  ""      $media_query_authorization;
  default $http_authorization;
}
map $media_header_or_query $media_authorization {
  ""      "Bearer $cookie_s2cam_stream_token";
  default $media_header_or_query;
}
map $uri $media_cookie_path {
    ~^(/hls/cam_[a-zA-Z0-9_-]+/) $1;
    default /hls/;
}
map $arg_token $media_token_cookie {
  ""      "";
    default "s2cam_stream_token=$arg_token; Path=$media_cookie_path; Max-Age=300; HttpOnly; Secure; SameSite=Strict";
}

server {
  listen 80;
  server_name drac.example.com;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name drac.example.com;

  ssl_certificate /etc/letsencrypt/live/drac.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/drac.example.com/privkey.pem;

  client_max_body_size 512m;

  location / {
    proxy_pass http://127.0.0.1:5173;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
  }

  location /api/ {
    proxy_pass http://127.0.0.1:3000/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
  }

  # Optional: MediaMTX WebRTC HTTP signaling through the same domain.
  # UDP media still needs port 8189/udp reachable unless you configure TURN.
  location /webrtc/ {
    proxy_pass http://127.0.0.1:8889/;
    proxy_redirect ~^/(cam_.*)$ /webrtc/$1;
    proxy_redirect ~^https?://[^/]+/(cam_.*)$ /webrtc/$1;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
  }

  # HLS fallback under the same HTTPS origin.
    location /hls/ {
        add_header X-S2Cam-Hls-Session "camera" always;
    proxy_pass http://127.0.0.1:8888/;
    proxy_set_header Authorization $media_authorization;
    add_header Set-Cookie $media_token_cookie always;
    proxy_redirect ~^/(cam_.*)$ /hls/$1;
    proxy_redirect ~^https?://[^/]+/(cam_.*)$ /hls/$1;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Range $http_range;
    proxy_set_header If-Range $http_if_range;
    proxy_buffering off;
    proxy_cache off;
  }
}
