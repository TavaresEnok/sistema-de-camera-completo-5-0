# ════════════════════════════════════════════════════════════════════════════
# ARQUIVO DE RESPOSTAS — instalação DRAC para um cliente
#
#   cp scripts/instalacao-cliente.exemplo.env cliente.env
#   chmod 600 cliente.env          # contém a senha do administrador
#   nano cliente.env               # preencha os OBRIGATÓRIOS
#   sudo bash scripts/install-drac.sh --config cliente.env
#
# Uma chave por linha, CHAVE=valor. Linhas em branco e começadas por # são
# ignoradas. Chave desconhecida é ERRO — um nome mal digitado não vira padrão
# silencioso. Variável exportada no ambiente tem precedência sobre o arquivo.
#
# Com --config o instalador NÃO faz perguntas: ele instala do começo ao fim
# sozinho, e o que faltar ele diz pelo nome.
# ════════════════════════════════════════════════════════════════════════════

# ─── OBRIGATÓRIOS ───────────────────────────────────────────────────────────

# Commit exato (40 caracteres) que será instalado. É a versão auditada; o
# instalador recusa qualquer coisa diferente disso no checkout final.
DRAC_INSTALLER_COMMIT=

# Nome do cliente, como aparece na Central.
DRAC_CUSTOMER_NAME=

# CIDRs EXCLUSIVOS das redes de câmeras deste cliente (separados por vírgula).
# Serve para o sistema recusar cadastrar como câmera um endereço que não seja
# de câmera. Ex.: 192.168.100.0/24
DRAC_CAMERA_ALLOWED_CIDRS=

# ─── IDENTIDADE DA INSTALAÇÃO ───────────────────────────────────────────────

# Código curto da instalação. Vazio = derivado do nome do cliente.
# DRAC_INSTALLATION_ID=

# Licença. Vazio = gerada aleatoriamente na instalação.
# DRAC_LICENSE_KEY=

# IP ou domínio deste servidor, como o cliente vai acessá-lo.
# Vazio = detectado pelo primeiro IPv4 da máquina.
# DRAC_SERVER_IP=

# Host compacto para o link RTMP das câmeras (útil quando o acesso é por
# domínio e você NÃO quer publicar um IP privado por engano).
# DRAC_RTMP_SHORT_HOST=

# ─── PRIMEIRO ADMINISTRADOR ─────────────────────────────────────────────────
#
# Sem isto a instalação terminaria sem nenhum usuário. Se a senha ficar vazia,
# o instalador gera uma forte e a imprime no fim (e grava em
# infra/.credenciais-iniciais, modo 600). Se já existir qualquer usuário no
# banco, NADA aqui é aplicado — reinstalar não reseta a senha de quem usa.

# Nome usado para entrar. Aceita nomes simples, como beira_mar, ou um e-mail.
# Vazio = admin. O e-mail abaixo é opcional e serve somente para recuperar senha.
# DRAC_ADMIN_USERNAME=

# E-mail de recuperação opcional.
# DRAC_ADMIN_EMAIL=

# Mínimo 10 caracteres. Vazio = gerada e mostrada uma única vez.
# DRAC_ADMIN_PASSWORD=

# DRAC_ADMIN_NAME=Administrador
# Instalação remota entrega acesso inicial pela Central, sem arquivo/log.
# CLI interativa mantém a cópia protegida tradicional quando true.
# DRAC_PERSIST_INITIAL_CREDENTIALS=true

# ─── CENTRAL ────────────────────────────────────────────────────────────────
#
# SENHA DE MATRÍCULA — como esta instalação se registra na Central.
#
# Sem registro a instalação fica sem licença e é SUSPENSA em 15 dias, então
# este passo não é opcional: existem dois caminhos e você precisa de um.
#
#   a) preencher esta senha (a mesma configurada na Central em
#      DRAC_CENTRAL_ENROLLMENT_TOKEN) — a instalação se matricula sozinha; ou
#   b) provisionar o cliente pelo painel da Central ANTES de instalar, e usar
#      aqui o DRAC_INSTALLATION_ID e o DRAC_LICENSE_KEY que ele mostrar.
#
# Se nenhum dos dois for feito, o instalador PARA e diz o motivo — em vez de
# terminar "com sucesso" deixando uma instalação órfã, que era o que acontecia
# até 24/08/2026.
# DRAC_ENROLLMENT_TOKEN=

# DRAC_CENTRAL_URL=https://central.s2cam.com.br

# ─── ONDE E COMO INSTALAR ───────────────────────────────────────────────────

# DRAC_INSTALL_DIR=/opt/drac
# DRAC_OPERATING_USER=          # vazio = quem chamou o sudo, ou "drac"
# DRAC_ENVIRONMENT=prod         # prod | dev
# DRAC_REPO_URL=https://github.com/TavaresEnok/sistema-de-camera-completo-5-0.git

# ─── MONITORAMENTO ──────────────────────────────────────────────────────────

# DRAC_WATCHDOG_ENABLED=true
# DRAC_WATCHDOG_INTERVAL_MINUTES=5

# Só o servidor MESTRE tem agente de build. Em servidor de cliente deixe
# desligado, senão o watchdog alerta "build-agent:unreachable" para sempre —
# e alerta que nunca apaga ensina o operador a ignorar o painel.
# DRAC_BUILD_AGENT_EXPECTED=false
